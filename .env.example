# Google Gemini API Key (선택 사항: 클라우드 LLM 사용 시)
GEMINI_API_KEY=

# Server Configuration
TUBEINSIGHT_PORT=8989
TUBEINSIGHT_LLM_BACKEND=lmstudio
TUBEINSIGHT_NUM_CTX=16384

# Meta Threads API Configuration (선택 사항: https://developers.facebook.com)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_MOCK=false

# X (Twitter) API v2 Configuration (선택 사항: https://developer.x.com)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_MOCK=false
